# Turns the files in web/ into a C header (web_assets.h) so the Pico can serve them.
# Run by the build: cmake -DDIR=<web dir> -DOUT=<header> -P embed.cmake
set(FILES index.html setup.html settings.html style.css app.js manifest.webmanifest icon.png)
set(body "// Generated from firmware/web/ by embed.cmake - edit the files there, not this header.\n#pragma once\n#include <stdint.h>\n\n")
set(table "typedef struct { const char* path; const char* type; const uint8_t* data; uint32_t len; } web_asset_t;\nstatic const web_asset_t web_assets[] = {\n")
foreach(f ${FILES})
    file(READ ${DIR}/${f} hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR len "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(MAKE_C_IDENTIFIER "web_${f}" id)
    string(APPEND body "static const uint8_t ${id}[${len}] = {${hex}};\n")
    if(f MATCHES "\\.html$")
        set(type "text/html; charset=utf-8")
    elseif(f MATCHES "\\.css$")
        set(type "text/css")
    elseif(f MATCHES "\\.js$")
        set(type "application/javascript")
    elseif(f MATCHES "\\.webmanifest$")
        set(type "application/manifest+json")
    elseif(f MATCHES "\\.png$")
        set(type "image/png")
    else()
        set(type "application/octet-stream")
    endif()
    string(APPEND table "    {\"/${f}\", \"${type}\", ${id}, ${len}},\n")
endforeach()
string(APPEND table "};\n#define WEB_ASSET_COUNT (sizeof(web_assets) / sizeof(web_assets[0]))\n")
file(WRITE ${OUT} "${body}\n${table}")
